            <kind>1</kind>
            <string>if use_path == false{
    exit;
}
if !(x &lt; view_xview[0] - 45 or 
x &gt; (view_xview[0] + view_wview[0]) + 45 or
y &lt; view_yview[0] - 45 or 
y &gt; (view_yview[0] + view_hview[0]) + 45){
    inView = true;
}
if inView == true and start_path == false{
