        <arguments>
          <argument>
            <kind>1</kind>
            <string>//setting variables
player = "Enemy";
max_hp = 18;
hp = max_hp;
image_speed = 0;
inView = false;
start_path = false;
view_player = true;
use_path = false;
rotate_with_direction = false;
</string>
