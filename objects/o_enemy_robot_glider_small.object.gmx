    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//making sure that the arm is pointing in the same direction that we're looking
if view_player == true{
    if instance_exists(o_player) {
        if o_player.x &lt; x and !collision_line(x, y, o_player.x, o_player.y, o_blockP, 0, 1){
            image_xscale = -1;
        }
        else if o_player.x &gt; x and !collision_line(x, y, o_player.x, o_player.y, o_blockP, 0, 1){
            image_xscale = 1;
        //head_angle = point_direction(x,y-7,o_player.x,o_player.y);
        }
    }
}
else if view_player == false and rotate_with_direction == true{
    if x &gt; xprevious{
        image_yscale = 1;
    }
    else if x &lt; xprevious{
        image_yscale = -1;
    }
}
else{
    if x &gt; xprevious{
        image_xscale = 1;
    }
    else if x &lt; xprevious{
        image_xscale = -1;
    }
}
if rotate_with_direction == true and start_path == true{
    image_angle = direction;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="1">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
