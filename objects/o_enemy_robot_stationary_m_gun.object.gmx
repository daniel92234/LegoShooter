with instance_create(x,y,o_bit) {sprite_index = s_enemy_robot_stationary_gun_part9; image_index = 0; image_speed = 0; speed = random_range(2, 6); direction = random_range(0, 359)}
with instance_create(x,y,o_bit) {sprite_index = s_enemy_robot_stationary_gun_part10; image_index = 0; image_speed = 0; speed = random_range(2, 6); direction = random_range(0, 359)}
