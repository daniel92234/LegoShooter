        <arguments>
          <argument>
            <kind>1</kind>
            <string>if state == "Ground" or state == "Inactive"{
    exit;
}
else if state == "Active"{
    if reload_state == "Out" and total_ammo &gt; 0{
        event_user(0);
    }
}
</string>
