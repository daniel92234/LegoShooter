        }
        change = 4 * gun_slot_2.clip_size + lost;
        o_player_control.dialouge[1] = 200;
        o_player_control.pickup_gun = gun_slot_2.id;
        with other{
            instance_destroy();
        }
    }
exit;
}
</string>
          </argument>
        </arguments>
      </action>
